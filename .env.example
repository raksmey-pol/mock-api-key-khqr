# Works without credentials in mock mode. The mock QR always uses mock_store@devb.
PAYMENT_MODE=mock

# Persistent local storage. Run on a Node server with a writable disk.
DATABASE_PATH=.data/khqr.sqlite

KHQR_MERCHANT_NAME=Mekong Store
KHQR_MERCHANT_CITY=Phnom Penh
KHQR_EXPIRATION_MINUTES=5

# BAKONG_ACCOUNT_ID is required in Bakong mode. BAKONG_TOKEN is the Open API key
# sent in the x-api-key header; required only for polling.
# Never prefix credentials with NEXT_PUBLIC_. Register at https://api-bakong.nbc.gov.kh/.
BAKONG_API_URL=https://sit-api-bakong.nbc.gov.kh
BAKONG_ACCOUNT_ID=
BAKONG_TOKEN=

# Optional: use merchant KHQR instead of individual KHQR. Set both together.
KHQR_MERCHANT_ID=
KHQR_ACQUIRING_BANK=

# Shared webhook key for signed HMAC or token-header authentication.
# The key stays on the server. The provider sends it in x-webhook-secret for token mode.
WEBHOOK_SECRET=

# Hosted Bakong checkout page. Set BAKONG_MERCHANT_TOKEN together with
# OPEN_API_BASE to enable the checkout-page switch in the storefront settings
# and the merchant endpoints under /v1/checkout/sessions. With both unset the
# demo emulates the page.
OPEN_API_BASE=
# Legacy alias for OPEN_API_BASE; OPEN_API_BASE takes precedence when both are set.
BAKONG_CHECKOUT_API_URL=
# Origin that serves checkout.js and the hosted checkout page (for example
# http://localhost:8788). Required for the checkout.js popup mode. The browser
# only receives this public origin; the merchant token stays on the server.
CHECKOUT_HOST=
# Merchant token for checkout-page sessions; issued during onboarding (mbk...).
BAKONG_MERCHANT_TOKEN=

# Default for new orders: signed when a secret is set, otherwise unsigned.
# Choose signed, token, or unsigned here; the UI can select per order.
WEBHOOK_SIGNATURE_MODE=
