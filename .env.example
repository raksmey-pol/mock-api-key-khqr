# Works without credentials in mock mode. The mock QR always uses mock_store@devb.
PAYMENT_MODE=mock

# Persistent local storage. Run on a Node server with a writable disk.
DATABASE_PATH=.data/khqr.sqlite

KHQR_MERCHANT_NAME=Mekong Store
KHQR_MERCHANT_CITY=Phnom Penh
KHQR_EXPIRATION_MINUTES=5

# Required only when PAYMENT_MODE=bakong. Never prefix these with NEXT_PUBLIC_.
# Register at https://api-bakong.nbc.gov.kh/ or the Bakong SIT portal.
BAKONG_API_URL=https://api-bakong.nbc.gov.kh
BAKONG_ACCOUNT_ID=
BAKONG_TOKEN=

# Optional: use merchant KHQR instead of individual KHQR. Set both together.
KHQR_MERCHANT_ID=
KHQR_ACQUIRING_BANK=

# x-webhook-secret header required whenever this is set.
# Required for webhook mode with Bakong; optional for a local mock demo.
# The simulator supplies it on the server, never from the browser.
WEBHOOK_SECRET=
